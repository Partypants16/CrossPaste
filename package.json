{
  "name": "crosspaste",
  "version": "1.0.0",
  "description": "Self-hosted shared clipboard for text and images across devices on a LAN or VPN.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test",
    "backup": "bash scripts/backup.sh",
    "db:check": "bash scripts/database-check.sh",
    "orphans:find": "node scripts/find-orphans.js",
    "data:clear": "node scripts/clear-data.js",
    "state:export": "node scripts/export-state.js",
    "state:import": "node scripts/import-state.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
