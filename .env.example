# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# .env is never committed to git (see .gitignore) because it can hold the optional
# access token and reflects one specific deployment's local network configuration.

# --- Runtime ---
NODE_ENV=production

# Address the Node.js server binds to inside its container. 0.0.0.0 accepts
# connections from the LAN and from any routed VPN interface. Only change this to
# 127.0.0.1 if you specifically want to block everything except localhost.
APP_HOST=0.0.0.0

# Port the Node.js server listens on inside its container.
APP_PORT=3000

# Hostname Caddy issues its internal HTTPS certificate for (see README:
# "Configuring internal HTTPS"). Purely a label until you point local DNS or a hosts
# file entry at your server's IP address.
INTERNAL_HOSTNAME=crosspaste.home

# --- Text ---
# Maximum number of characters the shared text can contain.
TEXT_CHARACTER_LIMIT=500000

# Milliseconds of inactivity before the editor autosaves.
AUTOSAVE_DELAY_MS=800

# --- Images ---
# Maximum number of images stored at once, globally, across all devices.
IMAGE_COUNT_LIMIT=10

# Maximum accepted size of a single uploaded image, before server-side processing.
IMAGE_SIZE_LIMIT_MB=10

# Images wider or taller than this (in pixels) are downscaled on the longest side.
# Animated GIFs are exempt, to preserve their animation.
IMAGE_MAX_DIMENSION=2000

# --- Files ---
# Maximum number of general files stored at once, globally, across all devices.
FILE_COUNT_LIMIT=10

# Maximum accepted size of a single uploaded file (at most 500). Uploads stream to
# disk, so this does not need matching memory on the server.
FILE_SIZE_LIMIT_MB=200

# --- Rate limiting ---
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20

# --- Storage paths (inside the app container; the compose.yaml bind-mounts ./data
# on the host to /app/data, so these normally do not need to change) ---
DATA_DIRECTORY=/app/data
UPLOAD_DIRECTORY=/app/data/uploads
THUMBNAIL_DIRECTORY=/app/data/thumbnails
FILES_DIRECTORY=/app/data/files

# --- Optional shared access token ---
# Leave blank (the default) to disable this entirely, with no login screen. If set,
# every device must enter this token once before using CrossPaste; it is not a user
# account system. Use a long random value, e.g. `openssl rand -hex 24`.
OPTIONAL_ACCESS_TOKEN=

# --- Optional automatic expiry ---
# 0 disables automatic expiry (the default). Set to a positive number of hours to
# automatically clear the shared text and delete images and files older than that duration.
CONTENT_EXPIRY_HOURS=0

# --- Logging ---
# One of: debug, info, warn, error
LOG_LEVEL=info
